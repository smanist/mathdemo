#!/usr/bin/env bash

set -euo pipefail

usage() {
  printf 'Usage: %s [-s FACTOR|--width-scale FACTOR] CHAPTER.md\n' "$(basename "$0")" >&2
  printf '       %s [-s FACTOR|--width-scale FACTOR] {-m|--merge} FIRST.md SECOND.md\n' "$(basename "$0")" >&2
  printf 'Converts docs/chapters/CHAPTER.md to pdfs/CHAPTER.pdf.\n' >&2
  printf 'With -m/--merge, combines two chapters into pdfs/FIRST-SECOND.pdf.\n' >&2
  printf 'Scales requested figure widths by FACTOR (default: 1).\n' >&2
}

width_scale=1
merge=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s | --width-scale)
      if [[ $# -lt 2 ]]; then
        printf 'error: %s requires a factor\n' "$1" >&2
        exit 2
      fi
      width_scale=$2
      shift 2
      ;;
    --width-scale=*)
      width_scale=${1#*=}
      shift
      ;;
    -m | --merge)
      merge=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'error: unknown option: %s\n' "$1" >&2
      usage
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ "$merge" == true && $# -ne 2 ]]; then
  printf 'error: --merge requires exactly two Markdown filenames\n' >&2
  usage
  exit 2
fi

if [[ "$merge" == false && $# -ne 1 ]]; then
  usage
  exit 2
fi

if [[ ! "$width_scale" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]]; then
  printf 'error: width scale must be a positive number: %s\n' "$width_scale" >&2
  exit 2
fi

chapter_names=("$@")
for chapter_name in "${chapter_names[@]}"; do
  case "$chapter_name" in
    */* | .md | "")
      printf 'error: pass a Markdown filename, not a path: %s\n' "$chapter_name" >&2
      exit 2
      ;;
    *.md)
      ;;
    *)
      printf 'error: chapter filename must end in .md: %s\n' "$chapter_name" >&2
      exit 2
      ;;
  esac
done

for program in awk pandoc xelatex; do
  if ! command -v "$program" >/dev/null 2>&1; then
    printf 'error: required program is not available: %s\n' "$program" >&2
    exit 1
  fi
done

if ! awk -v factor="$width_scale" 'BEGIN { exit !(factor > 0) }'; then
  printf 'error: width scale must be greater than zero: %s\n' "$width_scale" >&2
  exit 2
fi

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
chapters_dir="$repo_root/docs/chapters"
pdf_dir="$repo_root/pdfs"
if [[ "$merge" == true ]]; then
  pdf_name="${chapter_names[0]%.md}-${chapter_names[1]%.md}.pdf"
else
  pdf_name="${chapter_names[0]%.md}.pdf"
fi
output_file="$pdf_dir/$pdf_name"
lua_filter="$repo_root/scripts/pandoc-myst.lua"
latex_header="$repo_root/scripts/pandoc-math-header.tex"
myst_preprocessor="$repo_root/scripts/pandoc-myst-preprocess.awk"

for chapter_name in "${chapter_names[@]}"; do
  if [[ ! -f "$chapters_dir/$chapter_name" ]]; then
    printf 'error: chapter not found: docs/chapters/%s\n' "$chapter_name" >&2
    exit 1
  fi
done

mkdir -p "$pdf_dir"

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/mathdemo-convert.XXXXXX")
cleanup() {
  rm -rf -- "$work_dir"
}
trap cleanup EXIT HUP INT TERM

temporary_pdf="$work_dir/$pdf_name"
normalized_sources=()

for index in "${!chapter_names[@]}"; do
  normalized_source="$work_dir/input-$((index + 1)).md"
  awk -v width_scale="$width_scale" -f "$myst_preprocessor" \
    "$chapters_dir/${chapter_names[$index]}" >"$normalized_source"
  normalized_sources+=("$normalized_source")
done

pandoc_arguments=(
  "${normalized_sources[@]}"
  --from=commonmark_x+implicit_figures
)
if [[ "$merge" == true ]]; then
  pandoc_arguments+=(--file-scope)
fi
pandoc_arguments+=(
  "--lua-filter=$lua_filter"
  "--include-in-header=$latex_header"
  --number-sections
  --pdf-engine=xelatex
  "--resource-path=$chapters_dir:$repo_root/docs"
  --metadata title=
  --variable geometry:margin=0.8in
  "--output=$temporary_pdf"
)

pandoc "${pandoc_arguments[@]}"

mv -f -- "$temporary_pdf" "$output_file"
printf 'Created pdfs/%s\n' "$pdf_name"
